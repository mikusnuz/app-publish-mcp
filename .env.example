# ── Apple App Store Connect ──
APPLE_KEY_ID=YOUR_KEY_ID
# TEAM (default) or INDIVIDUAL. Individual keys omit APPLE_ISSUER_ID.
APPLE_KEY_TYPE=TEAM
APPLE_ISSUER_ID=YOUR_ISSUER_ID
APPLE_P8_PATH=/path/to/AuthKey_XXXXXX.p8

# ── Google Play Console ──
# Option 1: service account (takes precedence when set)
# Set to the downloaded JSON key path, or leave blank when using OAuth.
GOOGLE_SERVICE_ACCOUNT_PATH=

# Option 2: OAuth. Run `app-publish-mcp auth google` to save a refresh token
# automatically, or provide all three values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
