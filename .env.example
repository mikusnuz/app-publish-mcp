# ── Apple App Store Connect ──
APPLE_KEY_ID=YOUR_KEY_ID
# TEAM (default) or INDIVIDUAL. Individual keys omit APPLE_ISSUER_ID.
APPLE_KEY_TYPE=TEAM
APPLE_ISSUER_ID=YOUR_ISSUER_ID
APPLE_P8_PATH=/path/to/AuthKey_XXXXXX.p8

# ── Google Play Console ──
# Option 1: service account (takes precedence when set)
# Set to the downloaded JSON key path, or leave blank when using OAuth.
GOOGLE_SERVICE_ACCOUNT_PATH=

# Option 2: OAuth. Run `app-publish-mcp auth google` to save a refresh token
# automatically, or provide all three values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: vendor number for apple_get_sales_report / apple_get_finance_report
APPLE_VENDOR_NUMBER=

# Optional extra keys, picked per API (issuer and key type default to the main key's)
# Reports: Sales/Finance/Analytics, e.g. a Sales and Reports key
APPLE_REPORTS_KEY_ID=
APPLE_REPORTS_P8_PATH=
# Admin: analytics request creation/deletion; finance and reporting fallback
APPLE_ADMIN_KEY_ID=
APPLE_ADMIN_P8_PATH=

# Optional per-key overrides (otherwise inherit the main key's issuer and type):
# APPLE_REPORTS_ISSUER_ID=
# APPLE_REPORTS_KEY_TYPE=TEAM
# APPLE_ADMIN_ISSUER_ID=
# APPLE_ADMIN_KEY_TYPE=TEAM

# Optional: register only read tools (list/get/search/query/download, no Google edit creation or deletion)
APP_PUBLISH_READ_ONLY=
