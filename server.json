{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mikusnuz/app-publish",
  "description": "MCP server for App Store Connect & Google Play Console — iOS/Android app management",
  "repository": {
    "url": "https://github.com/mikusnuz/app-publish-mcp",
    "source": "github"
  },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "app-publish-mcp",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APPLE_KEY_ID",
          "description": "Apple App Store Connect API Key ID",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "APPLE_KEY_TYPE",
          "description": "Apple API key type: TEAM (default) or INDIVIDUAL",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "APPLE_ISSUER_ID",
          "description": "Apple App Store Connect Issuer ID for TEAM keys",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "APPLE_P8_PATH",
          "description": "Path to Apple AuthKey .p8 file",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GOOGLE_SERVICE_ACCOUNT_PATH",
          "description": "Path to Google Play service account JSON key file",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "description": "Google Desktop OAuth client ID",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "description": "Google Desktop OAuth client secret",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GOOGLE_REFRESH_TOKEN",
          "description": "Google OAuth refresh token",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
